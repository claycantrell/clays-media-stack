# Copy to .env, then: chmod 600 .env

# ProtonVPN OpenVPN credentials (account.protonvpn.com -> OpenVPN / IKEv2 username)
OPENVPN_USER=
OPENVPN_PASSWORD=

# uid:gid that owns ./config, ./media and ./downloads on the host. The containers
# run as this user, so it must actually own the files (Linux enforces this;
# Docker Desktop on macOS did not). Ubuntu's first user is 1000:1000 - check
# with `id -u` and `id -g`.
PUID=1000
PGID=1000

# Address the admin UIs (qBittorrent, Sonarr, Radarr, Prowlarr, FlareSolverr)
# are published on. They have NO authentication, so the bind is the access control.
#   127.0.0.1  this host only - reach them over an SSH tunnel (docs/UBUNTU-SERVER.md)
#   0.0.0.0    the whole LAN
ADMIN_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Remote access (profile: remote). LEAVE BLANK until you have a domain -
# nothing reads these unless you run `./stack.sh remote up`.
#
#   DOMAIN_WATCH    Jellyfin.   Cloudflare DNS = GREY cloud (DNS only).
#   DOMAIN_REQUEST  Jellyseerr. Cloudflare DNS = ORANGE cloud is fine.
#   CROWDSEC_API_KEY  generated AFTER first crowdsec start:
#       docker exec crowdsec cscli bouncers add caddy-bouncer
# ---------------------------------------------------------------------------
DOMAIN_WATCH=
DOMAIN_REQUEST=
CROWDSEC_API_KEY=
